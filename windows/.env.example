# Copy to .env in this directory. The launcher loads it regardless of your
# working directory. These are Docker Compose settings, not Windows settings.

# Leave localhost for testing, or use the Windows host's reserved LAN IPv4
# address to serve your trusted network. Keep actual addresses in .env only.
PIHOLE_BIND_IP=127.0.0.1
PIHOLE_WEB_PORT=8080

# Optional: set to this host's `tailscale ip -4` address, then start with
# .\windows\pihole.ps1 Start -Tailscale. Do not use a public/WAN address.
# PIHOLE_TAILSCALE_IP=YOUR_WINDOWS_TAILSCALE_IPV4
TZ=Etc/UTC

# The default follows the official image. For controlled updates, replace
# latest with a supported release tag or digest from pi-hole/docker-pi-hole.
PIHOLE_IMAGE=pihole/pihole:latest
