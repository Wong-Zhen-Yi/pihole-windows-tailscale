{
  "manifest_version": 3,
  "name": "Pi-hole Companion",
  "version": "1.2.1",
  "description": "Pi-hole v6 statistics, top domains and clients, query log, timed pauses and exact-domain rules.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "activeTab"],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Pi-hole Companion",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
